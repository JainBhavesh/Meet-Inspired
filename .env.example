# One env file for the whole app — client and server. Next.js only inlines
# variables prefixed with NEXT_PUBLIC_ into the browser bundle, so anything
# below stays server-only automatically. See README.md's "LiveKit setup"
# section for how to get these values (Cloud vs. self-hosted).

LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-project.livekit.cloud
